generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  KITCHEN
}

enum OrderStatus {
  PENDING
  PREPARING
  SERVED
  PAID
  CANCELLED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
}

enum PaymentMethod {
  CASH
  CARD
  PROMPTPAY
}

enum PaymentStatus {
  COMPLETED
  VOIDED
}

enum TableSessionStatus {
  OPEN
  CLOSED
  EXPIRED
}

enum ServiceRequestType {
  CALL_STAFF
  CHECKOUT
  OTHER
}

enum ServiceRequestStatus {
  PENDING
  RESOLVED
  CANCELLED
}

enum MenuOptionGroup {
  PROTEIN
  EXTRA
}

enum ExpenseCategory {
  INGREDIENTS
  UTILITIES
  SALARY
  EQUIPMENT
  RENT
  OTHER
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  menuItems MenuItem[]

  @@map("categories")
}

model MenuItem {
  id          String   @id @default(uuid())
  name        String
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  orderItems OrderItem[]
  options    MenuOption[]

  @@index([categoryId])
  @@map("menu_items")
}

/// วัตถุดิบของร้าน (หมู ไก่ ไข่ ...) — ผูกกับตัวเลือกเมนูได้หลายอัน
/// ของหมดก็ปิดที่นี่ทีเดียว ตัวเลือกที่ผูกไว้จะหมดตามทุกเมนู ไม่ต้องไล่ปิดทีละเมนู
model Ingredient {
  id          String   @id @default(uuid())
  name        String   @unique
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menuOptions MenuOption[]

  @@map("ingredients")
}

model MenuOption {
  id          String          @id @default(uuid())
  name        String
  price       Decimal         @default(0) @db.Decimal(10, 2)
  /// PROTEIN = เนื้อสัตว์ (ปกติเลือกอย่างเดียว), EXTRA = ท็อปปิ้ง/เพิ่มเติมอื่น ๆ
  group       MenuOptionGroup @default(EXTRA)
  isAvailable Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  menuItem         MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId       String
  orderItemOptions OrderItemOption[]

  // ผูกกับวัตถุดิบไว้ ถ้าวัตถุดิบหมด ตัวเลือกนี้ก็สั่งไม่ได้ (null = ไม่ผูกกับอะไร)
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  ingredientId String?

  @@index([menuItemId])
  @@index([menuItemId, group])
  @@index([ingredientId])
  @@map("menu_options")
}

model RestaurantTable {
  id     String      @id @default(uuid())
  number Int         @unique
  seats  Int         @default(4)
  status TableStatus @default(AVAILABLE)
  orders Order[]
  sessions TableSession[]
  serviceRequests ServiceRequest[]
  receipts Receipt[]

  @@map("restaurant_tables")
}

model TableSession {
  id        String             @id @default(uuid())
  token     String             @unique
  status    TableSessionStatus @default(OPEN)
  openedAt  DateTime           @default(now())
  closedAt  DateTime?
  expiresAt DateTime?

  table   RestaurantTable @relation(fields: [tableId], references: [id])
  tableId String

  orders Order[]
  serviceRequests ServiceRequest[]
  payments Payment[]
  receipts Receipt[]

  @@index([tableId, status])
  @@map("table_sessions")
}

model Order {
  id        String      @id @default(uuid())
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // ครัวกด "ทำเสร็จเรียบร้อย" = ยกของให้ลูกค้าแล้ว ให้หายจากบอร์ดถาวร
  // เก็บใน DB ไม่ใช่ state ในจอ ไม่งั้นรีเฟรชแล้วกลับมาใหม่ และจอครัวหลายเครื่องไม่ตรงกัน
  clearedAt DateTime?

  table   RestaurantTable @relation(fields: [tableId], references: [id])
  tableId String

  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id])
  tableSessionId String?

  // ออเดอร์นี้ถูกจ่ายด้วย payment ใบไหน (null = ยังไม่จ่าย) ใช้ตอนแยกบิล
  payment   Payment? @relation(fields: [paymentId], references: [id])
  paymentId String?

  items   OrderItem[]

  @@index([tableId, status])
  @@index([tableSessionId])
  @@index([paymentId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2)
  note      String?

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId String

  selectedOptions OrderItemOption[]

  @@map("order_items")
}

model OrderItemOption {
  id        String   @id @default(uuid())
  name      String
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  orderItem    OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId  String
  menuOption   MenuOption @relation(fields: [menuOptionId], references: [id])
  menuOptionId String

  @@index([orderItemId])
  @@index([menuOptionId])
  @@map("order_item_options")
}

model Payment {
  id     String        @id @default(uuid())
  amount Decimal       @db.Decimal(10, 2)
  method PaymentMethod
  status PaymentStatus @default(COMPLETED)
  paidAt DateTime      @default(now())

  // ยกเลิกบิลที่จ่ายผิด: เก็บแถวไว้เป็นหลักฐาน ไม่ลบทิ้ง
  voidedAt   DateTime?
  voidReason String?

  // หมายเหตุที่พนักงานพิมพ์ตอนรับเงิน (สำเนาอยู่ที่ Receipt.note ด้วย)
  note String?

  tableSession   TableSession @relation(fields: [tableSessionId], references: [id])
  tableSessionId String

  // แยกบิลได้: payment หนึ่งใบครอบคลุมเฉพาะออเดอร์ที่ระบุ
  orders  Order[]
  receipt Receipt?

  @@index([tableSessionId, status])
  @@map("payments")
}

model ServiceRequest {
  id        String               @id @default(uuid())
  type      ServiceRequestType
  status    ServiceRequestStatus @default(PENDING)
  createdAt DateTime             @default(now())
  resolvedAt DateTime?

  // เฉพาะ type=CHECKOUT: วิธีจ่ายเงินที่ลูกค้าเลือกไว้ตอนขอเช็คบิล (แคชเชียร์แก้ไขได้ก่อนชำระจริง)
  paymentMethod PaymentMethod?

  table   RestaurantTable @relation(fields: [tableId], references: [id])
  tableId String

  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id])
  tableSessionId String?

  @@index([tableId, status])
  @@index([tableSessionId, status])
  @@map("service_requests")
}

model Receipt {
  id        String   @id @default(uuid())
  number    String   @unique
  subtotal  Decimal  @db.Decimal(10, 2)
  discount  Decimal  @default(0) @db.Decimal(10, 2)
  total     Decimal  @db.Decimal(10, 2)
  issuedAt  DateTime @default(now())
  // หมายเหตุพิมพ์ท้ายใบเสร็จ — คัดลอกจาก Payment.note ตอนออกใบเสร็จ
  note      String?

  payment   Payment @relation(fields: [paymentId], references: [id])
  paymentId String  @unique

  table   RestaurantTable @relation(fields: [tableId], references: [id])
  tableId String

  tableSession   TableSession @relation(fields: [tableSessionId], references: [id])
  tableSessionId String

  items ReceiptItem[]

  @@index([tableId])
  @@index([tableSessionId])
  @@map("receipts")
}

/// รายจ่ายของร้าน ใช้คู่กับรายรับจาก Payment ในหน้า report
model Expense {
  id       String          @id @default(uuid())
  title    String
  amount   Decimal         @db.Decimal(10, 2)
  category ExpenseCategory
  note     String?
  spentAt  DateTime        @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spentAt])
  @@index([category, spentAt])
  @@map("expenses")
}

model ReceiptItem {
  id          String  @id @default(uuid())
  name        String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  optionTotal Decimal @default(0) @db.Decimal(10, 2)
  lineTotal   Decimal @db.Decimal(10, 2)
  note        String?
  orderId     String?

  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  receiptId String

  @@index([receiptId])
  @@map("receipt_items")
}
