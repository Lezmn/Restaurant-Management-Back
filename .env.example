# ==== Postgres (docker-compose ใช้ค่านี้สร้าง container) ====
POSTGRES_USER="restaurant"
POSTGRES_PASSWORD="change-me-strong-db-password"
POSTGRES_DB="restaurant_db"

# ==== Nest app ====
# ตอนรัน Nest แบบ local (นอก Docker) ชี้ localhost:5433 ; ใน Docker compose จะประกอบ URL ให้เองจากค่าด้านบน
DATABASE_URL="postgresql://restaurant:change-me-strong-db-password@localhost:5433/restaurant_db?schema=public"
PORT=3000
NODE_ENV="development"

# สุ่มค่ายาว ≥ 32 ตัวอักษร เช่น: openssl rand -base64 48  — ห้าม commit .env
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="8h"

# origin ของ frontend ที่อนุญาตให้เรียก API และต่อ WebSocket (คั่นหลายค่าด้วย comma)
CORS_ORIGIN="http://localhost:5173"

# ==== Hardening ====
# rate limit ต่อคน (ครั้ง/นาที) — นับแยกตามพนักงาน (JWT) / QR โต๊ะ / IP ถ้าไม่มีทั้งคู่
# /auth/login ล็อกไว้ที่ 5 ครั้ง/นาที/IP แยกต่างหาก
# ร้านมักใช้บัญชีพนักงานเดียวกันหลายเครื่อง และตอน socket หลุดหน้าเก็บเงิน poll ~60 ครั้ง/นาที/เครื่อง
THROTTLE_LIMIT=300
# เพดานรวมต่อ IP (ครั้ง/นาที) — ทั้งร้านมักออกเน็ต IP เดียวกัน จึงต้องสูงพอให้ทุกเครื่องรวมกันไม่ชน
THROTTLE_IP_LIMIT=1000
# production ปิด Swagger /docs โดย default — ตั้ง true ชั่วคราวเมื่อต้องใช้
SWAGGER_ENABLED=false
# ตั้ง true เฉพาะเมื่อมี nginx/reverse proxy อยู่หน้า API จริง ๆ เพื่อให้ rate limit เห็น IP จริงของ client
# ห้ามตั้ง true ถ้า client ต่อตรงเข้า API — ใครก็ปลอม X-Forwarded-For เพื่อเลี่ยงการล็อก login ได้
TRUST_PROXY=false

# ==== ตรวจสลิป PromptPay (SlipOK) ====
# ได้จากหน้าสาขาในบัญชี SlipOK — ห้าม commit / ห้ามใส่ใน .env ของ frontend
# ต้องผูกบัญชีธนาคารของร้านใน LINE LIFF ของ SlipOK ด้วย ถึงจะตรวจ "โอนเข้าบัญชีร้าน" (error 1014) ได้
SLIPOK_API_KEY=""
SLIPOK_BRANCH_ID=""
# true = โหมดจำลอง (ทดสอบก่อนมีบัญชี) ห้ามใช้กับร้านจริง — ไม่ตั้ง key และไม่เปิด mock = บิล PromptPay เป็น "รอตรวจ"
SLIPOK_MOCK=false
# ตรวจสลิปที่ค้าง "รอตรวจ" ซ้ำทุกกี่ ms และสูงสุดกี่ครั้ง (ค่าเริ่มต้น 2 นาที × 15 ครั้ง ≈ 30 นาที)
SLIP_RECHECK_INTERVAL_MS=120000
SLIP_RECHECK_MAX_ATTEMPTS=15

# ==== seed:prod (สร้าง ADMIN คนแรก + โต๊ะ) — ใช้เฉพาะตอนติดตั้งร้านจริงครั้งแรก ====
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="change-me-admin-password"
ADMIN_NAME="เจ้าของร้าน"
TABLE_COUNT=8
