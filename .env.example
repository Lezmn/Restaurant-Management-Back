# ใช้ค่านี้ตอนรัน Nest app แบบ local (นอก Docker) แต่ postgres รันใน Docker
DATABASE_URL="postgresql://restaurant:restaurant_pass@localhost:5433/restaurant_db?schema=public"
PORT=3000
# ใช้ค่า random ที่ยาวอย่างน้อย 32 ตัวอักษร และห้าม commit .env
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="8h"
