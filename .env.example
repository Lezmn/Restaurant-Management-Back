# ==== Postgres (docker-compose ใช้ค่านี้สร้าง container) ====
POSTGRES_USER="restaurant"
POSTGRES_PASSWORD="change-me-strong-db-password"
POSTGRES_DB="restaurant_db"

# ==== Nest app ====
# ตอนรัน Nest แบบ local (นอก Docker) ชี้ localhost:5433 ; ใน Docker compose จะประกอบ URL ให้เองจากค่าด้านบน
DATABASE_URL="postgresql://restaurant:change-me-strong-db-password@localhost:5433/restaurant_db?schema=public"
PORT=3000
NODE_ENV="development"

# สุ่มค่ายาว ≥ 32 ตัวอักษร เช่น: openssl rand -base64 48  — ห้าม commit .env
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="8h"

# origin ของ frontend ที่อนุญาตให้เรียก API และต่อ WebSocket (คั่นหลายค่าด้วย comma)
CORS_ORIGIN="http://localhost:5173"

# ==== Hardening ====
# rate limit ต่อ IP (ครั้ง/นาที) — /auth/login ล็อกไว้ที่ 5 ครั้ง/นาทีแยกต่างหาก
THROTTLE_LIMIT=100
# production ปิด Swagger /docs โดย default — ตั้ง true ชั่วคราวเมื่อต้องใช้
SWAGGER_ENABLED=false
# ตั้ง true เมื่ออยู่หลัง nginx/reverse proxy เพื่อให้ rate limit เห็น IP จริงของ client
TRUST_PROXY=false

# ==== seed:prod (สร้าง ADMIN คนแรก + โต๊ะ) — ใช้เฉพาะตอนติดตั้งร้านจริงครั้งแรก ====
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="change-me-admin-password"
ADMIN_NAME="เจ้าของร้าน"
TABLE_COUNT=8
